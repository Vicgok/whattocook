# Safe to expose in the Expo bundle. Never use the service-role key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
EXPO_PUBLIC_APP_SCHEME=whattocook
# Provider controls are hidden until both the Supabase provider and its client
# integration are configured. Only magic-link email has a client implementation.
EXPO_PUBLIC_AUTH_EMAIL_MAGIC_LINK_ENABLED=false
EXPO_PUBLIC_AUTH_GOOGLE_ENABLED=false
EXPO_PUBLIC_AUTH_APPLE_ENABLED=false
# Do not set these until hosted legal documents exist.
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=
